jkhdgffversion: 2

models:
  - name: fct_orders
    description: >
      One row per order. Revenue, payment, delivery performance, and review
      score joined at order grain. Item and payment many-to-one relationships
      are pre-aggregated upstream to avoid fan-out.
    columns:
      - name: order_id
        description: Primary key. Unique identifier for an order.
        tests: [unique, not_null]

      - name: customer_id
        description: Per-order customer identifier from the source system.
        tests:
          - not_null
          - relationships:
              to: ref('stg_olist__customers')
              field: customer_id

      - name: total_revenue
        tests:
          - not_null
          - dbt_utils.accepted_range:
              min_value: 0
              inclusive: true

      - name: order_status
        tests:
          - accepted_values:
              values:
                - delivered
                - shipped
                - canceled
                - unavailable
                - invoiced
                - processing
                - created
                - approved

      - name: review_score
        tests:
          - dbt_utils.accepted_range:
              min_value: 1
              max_value: 5
              inclusive: true

  - name: dim_customers
    description: One row per customer_unique_id, the person-level identifier.
    columns:
      - name: customer_unique_id
        tests: [unique, not_null]
      - name: lifetime_revenue
        tests:
          - dbt_utils.accepted_range:
              min_value: 0
              inclusive: true
      - name: customer_segment
        tests:
          - accepted_values:
              values: ['repeat', 'one_time']

  - name: dim_products
    columns:
      - name: product_id
        tests: [unique, not_null]

  - name: fct_marketing_funnel
    columns:
      - name: mql_id
        tests: [unique, not_null]
      - name: seller_id
        tests:
          - relationships:
              to: ref('stg_olist__sellers')
              field: seller_id
              config:
                where: "seller_id is not null"

  - name: agg_daily_revenue
    tests:
      - dbt_utils.unique_combination_of_columns:
          combination_of_columns:
            - order_date
            - product_category
            - customer_state
